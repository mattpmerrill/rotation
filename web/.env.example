# Every environment variable the web app reads. Copy to .env.development.local for local work and
# fill in the values (from `supabase status` for a local stack). Never commit real values.
# They are parsed and validated once, at src/data/env.ts; add a variable there and here together.

# --- Public: compiled into the browser bundle. Safe to expose; never put a secret behind NEXT_PUBLIC_ ---
# Supabase project URL (local stack: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key. RLS decides what it can do
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only ---
# Supabase secret key: bypasses RLS. Used only by the scheduled job (optional locally)
SUPABASE_SECRET_KEY=
# Bearer token the scheduler sends to /api/jobs/daily; at least 16 characters (optional locally)
CRON_SECRET=
# The group's Discord channel webhook. Without it, notifications are skipped
DISCORD_WEBHOOK_URL=
# CoinGecko Demo key for live prices. Optional: the keyless API works with lower limits
COINGECKO_API_KEY=
