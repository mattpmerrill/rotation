# Engine settings. Copy to .env and fill in. Never commit .env.
# (The web app's settings are in docs/architecture.md, "Secrets and configuration".)

# CoinGecko: a free Demo key covers the daily job; the historical backfill needed Analyst+.
COINGECKO_API_KEY=
COINGECKO_PLAN=demo            # demo | pro

# Where the Parquet research cache lives (default: <repo>/data)
ROTATION_DATA_DIR=

# Direct Postgres URL: the daily job writes market data with it
SUPABASE_DB_URL=
