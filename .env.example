# Copy to .env and fill in. Never commit .env.

# CoinGecko: a Demo key works for recent data; the historical backfill needs Analyst+.
COINGECKO_API_KEY=
COINGECKO_PLAN=demo            # demo | pro

# Where the Parquet cache lives (default: <repo>/data)
ROTATION_DATA_DIR=

# Phase 1+
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=               # direct Postgres URL, for `rotation load`
ANTHROPIC_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=           # public channel: shares only, never holdings or amounts
DISCORD_PRIVATE_WEBHOOK_URL=   # optional private channel: exact amounts
