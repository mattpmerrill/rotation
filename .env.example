COINGECKO_PLAN=demo            # demo | pro

# Where the Parquet cache lives (default: <repo>/data)
ROTATION_DATA_DIR=

# Phase 1+
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
DISCORD_BOT_TOKEN=
